---
// Banner de la versión 2. Todo hecho con código (sin imágenes):
//  - un campo de estrellas en <canvas> que se desplaza solo, reacciona al
//    mouse (y en el celular "pasea" un puntero virtual) y dibuja
//    constelaciones entre las estrellas cercanas,
//  - nebulosa, planeta y luna con parallax según el puntero,
//  - el título aparece letra por letra.
// El canvas se pausa cuando el banner no se ve y queda quieto si el sistema
// tiene activado "reducir movimiento".
const lines = [
  { text: "Que tu marca", accent: false },
  { text: "no sea una más.", accent: true },
];

let n = 0;
const titleLines = lines.map((line) => ({
  accent: line.accent,
  words: line.text.split(" ").map((word) => ({
    chars: [...word].map((c) => ({ c, i: n++ })),
  })),
}));
---

<section class="vh" id="inicio">
  <canvas class="vh__stars" aria-hidden="true"></canvas>

  <div class="vh__nebula" aria-hidden="true">
    <i class="vh__blob vh__blob--a"></i>
    <i class="vh__blob vh__blob--b"></i>
    <i class="vh__blob vh__blob--c"></i>
  </div>

  <div class="vh__scene" aria-hidden="true">
    <div class="vh__planet">
      <span class="vh__ring"></span>
    </div>
    <span class="vh__moon"></span>
  </div>

  <div class="v2-container vh__inner">
    <p class="vh__kicker">Diseño gráfico &amp; Motion Graphics</p>

    <h1 class="vh__title" aria-label="Que tu marca no sea una más.">
      {titleLines.map((line) => (
        <span class:list={["vh__line", { "vh__line--accent": line.accent }]} aria-hidden="true">
          {line.words.map((word, wi) => (
            <>
              {wi > 0 && " "}
              <span class="vh__word">
                {word.chars.map((ch) => (
                  <span class="vh__ch" style={`--i:${ch.i}`}>{ch.c}</span>
                ))}
              </span>
            </>
          ))}
        </span>
      ))}
    </h1>

    <p class="vh__subtitle">
      Con más de 6 años de experiencia en diseño gráfico, ayudo a marcas a
      diferenciarse a través de la identidad visual, el branding y la
      animación.
    </p>

    <div class="vh__actions">
      <a href="#contacto" class="v2-btn v2-btn--cta">Contacto</a>
      <a href="#trabajo" class="v2-btn">Ver trabajos</a>
    </div>
  </div>

  <a href="#clientes" class="vh__scroll" aria-label="Bajar">
    <span></span>
  </a>
</section>

<style>
  .vh {
    --px: 0;
    --py: 0;
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(60% 80% at 82% 10%, color-mix(in srgb, var(--accent) 30%, transparent) 0%, transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg) 55%, #000) 0%, var(--bg) 100%);
  }

  .vh__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* ---------- nebulosa (estática) ---------- */
  .vh__nebula {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .vh__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    transform: translate3d(calc(var(--px) * 22px), calc(var(--py) * 16px), 0);
    will-change: transform;
  }

  .vh__blob--a {
    width: 46vw;
    height: 46vw;
    right: -8vw;
    top: -12vw;
    background: color-mix(in srgb, var(--accent) 55%, transparent);
    opacity: 0.55;
  }

  .vh__blob--b {
    width: 34vw;
    height: 34vw;
    left: 28vw;
    bottom: -16vw;
    background: color-mix(in srgb, var(--accent) 40%, transparent);
    opacity: 0.4;
  }

  .vh__blob--c {
    width: 28vw;
    height: 28vw;
    left: -8vw;
    bottom: -8vw;
    background: color-mix(in srgb, var(--accent-2) 28%, transparent);
    opacity: 0.32;
  }

  /* ---------- planeta + luna (parallax) ---------- */
  .vh__scene {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .vh__planet {
    position: absolute;
    right: -9vw;
    bottom: -20%;
    width: min(640px, 52vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 24%, #3a2070 0%, #1c0f3d 40%, #0a0519 78%);
    box-shadow:
      inset 16px 16px 56px -16px color-mix(in srgb, var(--accent-2) 60%, transparent),
      inset -50px -50px 100px rgba(0, 0, 0, 0.6),
      0 0 140px -10px color-mix(in srgb, var(--accent) 50%, transparent);
    transform: translate3d(calc(var(--px) * -30px), calc(var(--py) * -22px), 0);
    will-change: transform;
    animation: planetFloat 14s ease-in-out infinite alternate;
  }

  .vh__ring {
    position: absolute;
    inset: -16%;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--accent-2) 45%, transparent);
    border-left-color: transparent;
    border-bottom-color: color-mix(in srgb, var(--accent) 50%, transparent);
    transform: rotateX(72deg) rotateZ(-20deg);
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent-2) 25%, transparent);
  }

  .vh__moon {
    position: absolute;
    right: 38vw;
    top: 20%;
    width: clamp(34px, 5vw, 64px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, #e9dcff 0%, #8f6ad8 45%, #2a1650 100%);
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 60%, transparent);
    transform: translate3d(calc(var(--px) * 46px), calc(var(--py) * 32px), 0);
    will-change: transform;
    animation: moonBob 7s ease-in-out infinite alternate;
  }

  @keyframes planetFloat {
    from {
      margin-bottom: 0;
    }
    to {
      margin-bottom: 18px;
    }
  }

  @keyframes moonBob {
    from {
      margin-top: 0;
    }
    to {
      margin-top: -16px;
    }
  }

  /* ---------- contenido ---------- */
  .vh__inner {
    position: relative;
    z-index: 2;
    padding-top: 128px;
    padding-bottom: 112px;
    will-change: transform, opacity;
  }

  .vh__kicker {
    margin: 0 0 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-2);
    opacity: 0;
    animation: fadeUp 0.8s 0.1s ease forwards;
  }

  .vh__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 9.2vw, 112px);
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: #fff;
    perspective: 700px;
  }

  .vh__line {
    display: block;
  }

  .vh__line--accent {
    color: var(--accent-2);
    text-shadow: 0 0 46px color-mix(in srgb, var(--accent-2) 38%, transparent);
  }

  .vh__word {
    display: inline-block;
    white-space: nowrap;
  }

  .vh__ch {
    display: inline-block;
    opacity: 0;
    transform-origin: 50% 100%;
    animation: chIn 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(0.35s + var(--i) * 32ms);
  }

  @keyframes chIn {
    from {
      opacity: 0;
      transform: translate3d(0, 0.55em, 0) rotateX(-80deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .vh__subtitle {
    margin: 28px 0 0;
    max-width: 46ch;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.65;
    color: var(--text-muted);
    opacity: 0;
    animation: fadeUp 0.9s 1.3s ease forwards;
  }

  .vh__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
    opacity: 0;
    animation: fadeUp 0.9s 1.55s ease forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* indicador de scroll */
  .vh__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    z-index: 3;
    width: 26px;
    height: 44px;
    margin-left: -13px;
    border: 1.5px solid color-mix(in srgb, var(--text) 40%, transparent);
    border-radius: 14px;
    opacity: 0;
    animation: fadeUp 0.8s 2s ease forwards;
  }

  .vh__scroll span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 3px;
    height: 8px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--accent-2);
    animation: scrollDot 1.8s ease-in-out infinite;
  }

  @keyframes scrollDot {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    70% {
      transform: translateY(14px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }

  @media (max-width: 760px) {
    .vh__inner {
      padding-top: 112px;
      padding-bottom: 104px;
    }

    .vh__planet {
      right: -30vw;
      bottom: -26vw;
      width: 92vw;
      opacity: 0.85;
    }

    .vh__moon {
      right: 14vw;
      top: 17%;
    }

    .vh__actions .v2-btn {
      flex: 1 1 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vh__ch,
    .vh__kicker,
    .vh__subtitle,
    .vh__actions,
    .vh__scroll {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .vh__planet,
    .vh__moon,
    .vh__scroll span {
      animation: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>(".vh");
  const canvas = hero?.querySelector<HTMLCanvasElement>(".vh__stars") ?? null;
  const content = hero?.querySelector<HTMLElement>(".vh__inner") ?? null;
  const ctx = canvas?.getContext("2d") ?? null;

  if (hero && canvas && ctx) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(pointer: fine)").matches;
    const isSmall = () => window.innerWidth < 760;

    type Star = { x: number; y: number; z: number; r: number; t: number; s: number; c: number };
    const COLORS = ["255,255,255", "210,179,255", "200,255,128"];

    let w = 0;
    let h = 0;
    let stars: Star[] = [];
    let visible = true;
    let raf = 0;
    let last = 0;
    let px = 0;
    let py = 0;
    let tx = 0;
    let ty = 0;
    // puntero real (mouse) o virtual (celular / sin movimiento)
    const mouse = { x: -999, y: -999, active: false, lastMove: 0 };
    let meteor: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
    let nextMeteor = 3000;

    function build() {
      const small = isSmall();
      const count = Math.min(small ? 70 : 150, Math.round((w * h) / (small ? 6500 : 9000)));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        z: Math.random() * 0.85 + 0.15,
        r: Math.random() * 1.15 + 0.35,
        t: Math.random() * Math.PI * 2,
        s: 0.6 + Math.random() * 1.6,
        c: Math.random() < 0.72 ? 0 : Math.random() < 0.6 ? 1 : 2,
      }));
    }

    function resize() {
      const rect = hero!.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, isSmall() ? 1.5 : 2);
      w = rect.width;
      h = rect.height;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      build();
      if (reduce) draw(0, 0);
    }

    function draw(t: number, dt: number) {
      const c = ctx!;
      c.clearRect(0, 0, w, h);

      // puntero virtual: si no hay mouse (o hace rato que no se mueve) el
      // "cursor" recorre el banner solo, así el efecto también se ve en el celular.
      let mx = mouse.x;
      let my = mouse.y;
      const idle = !finePointer || t - mouse.lastMove > 2500;
      if (idle) {
        mx = w * (0.5 + 0.34 * Math.sin(t * 0.00035));
        my = h * (0.45 + 0.28 * Math.sin(t * 0.00051 + 1.3));
      }

      const near: { x: number; y: number; d: number }[] = [];
      const R = isSmall() ? 110 : 150;

      for (const s of stars) {
        let x = (((s.x - t * 0.012 * s.z + px * 26 * s.z) % w) + w) % w;
        const y = (((s.y + py * 16 * s.z) % h) + h) % h;
        const a = 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(t * 0.0016 * s.s + s.t));
        const col = COLORS[s.c];
        c.fillStyle = `rgba(${col},${(a * (0.4 + s.z * 0.6)).toFixed(3)})`;
        const size = s.r * (0.6 + s.z * 0.7);
        if (size > 1.05) {
          c.beginPath();
          c.arc(x, y, size, 0, 6.2832);
          c.fill();
        } else {
          c.fillRect(x - size, y - size, size * 2, size * 2);
        }
        const dx = x - mx;
        const dy = y - my;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d < R) near.push({ x, y, d });
      }

      // constelación alrededor del puntero
      if (near.length) {
        near.sort((a, b) => a.d - b.d);
        const pick = near.slice(0, 7);
        c.lineWidth = 1;
        for (let i = 0; i < pick.length; i++) {
          const p = pick[i];
          const alpha = (1 - p.d / R) * 0.55;
          c.strokeStyle = `rgba(166,255,46,${alpha.toFixed(3)})`;
          c.beginPath();
          c.moveTo(mx, my);
          c.lineTo(p.x, p.y);
          c.stroke();
          if (i > 0) {
            const q = pick[i - 1];
            c.strokeStyle = `rgba(210,179,255,${(alpha * 0.7).toFixed(3)})`;
            c.beginPath();
            c.moveTo(q.x, q.y);
            c.lineTo(p.x, p.y);
            c.stroke();
          }
          c.fillStyle = `rgba(166,255,46,${Math.min(1, alpha + 0.3).toFixed(3)})`;
          c.beginPath();
          c.arc(p.x, p.y, 2, 0, 6.2832);
          c.fill();
        }
      }

      // estrella fugaz ocasional
      if (!reduce) {
        nextMeteor -= dt;
        if (!meteor && nextMeteor <= 0) {
          meteor = { x: w * (0.4 + Math.random() * 0.6), y: Math.random() * h * 0.4, vx: -0.9, vy: 0.42, life: 0 };
          nextMeteor = 5000 + Math.random() * 6000;
        }
        if (meteor) {
          meteor.life += dt;
          const mxp = meteor.x + meteor.vx * meteor.life * 0.9;
          const myp = meteor.y + meteor.vy * meteor.life * 0.9;
          const fade = Math.max(0, 1 - meteor.life / 900);
          const g = c.createLinearGradient(mxp, myp, mxp + 120, myp - 56);
          g.addColorStop(0, `rgba(255,255,255,${fade.toFixed(3)})`);
          g.addColorStop(1, "rgba(255,255,255,0)");
          c.strokeStyle = g;
          c.lineWidth = 1.6;
          c.beginPath();
          c.moveTo(mxp, myp);
          c.lineTo(mxp + 120, myp - 56);
          c.stroke();
          if (meteor.life > 900) meteor = null;
        }
      }
    }

    function frame(now: number) {
      raf = 0;
      if (!visible) return;
      const dt = Math.min(now - (last || now), 64);
      last = now;

      // parallax suavizado (lerp) hacia el puntero
      px += (tx - px) * 0.06;
      py += (ty - py) * 0.06;
      hero!.style.setProperty("--px", px.toFixed(3));
      hero!.style.setProperty("--py", py.toFixed(3));

      // el texto se aleja y se desvanece al scrollear
      if (content) {
        const p = Math.min(Math.max(window.scrollY / (h || 1), 0), 1);
        content.style.transform = `translate3d(0, ${(p * 70).toFixed(1)}px, 0)`;
        content.style.opacity = String(Math.max(0, 1 - p * 1.25).toFixed(3));
      }

      draw(now, dt);
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (reduce || raf || !visible) return;
      last = 0;
      raf = requestAnimationFrame(frame);
    }

    hero.addEventListener(
      "pointermove",
      (e) => {
        const rect = hero.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;
        mouse.lastMove = performance.now();
        tx = (e.clientX / window.innerWidth - 0.5) * 2;
        ty = ((e.clientY - rect.top) / (rect.height || 1) - 0.5) * 2;
      },
      { passive: true }
    );

    hero.addEventListener("pointerleave", () => {
      tx = 0;
      ty = 0;
    });

    // en celulares con giroscopio: el parallax también responde al movimiento
    // del teléfono (en iOS necesita permiso, así que solo se usa si ya está
    // disponible sin pedirlo).
    if (!finePointer && "DeviceOrientationEvent" in window && typeof (DeviceOrientationEvent as any).requestPermission !== "function") {
      window.addEventListener(
        "deviceorientation",
        (e) => {
          if (e.gamma == null || e.beta == null) return;
          tx = Math.max(-1, Math.min(1, e.gamma / 25));
          ty = Math.max(-1, Math.min(1, (e.beta - 45) / 25));
        },
        { passive: true }
      );
    }

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    });

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          if (visible) start();
        },
        { threshold: 0 }
      ).observe(hero);
    }

    document.addEventListener("visibilitychange", () => {
      visible = !document.hidden;
      if (visible) start();
    });

    resize();
    start();
  }
</script>
