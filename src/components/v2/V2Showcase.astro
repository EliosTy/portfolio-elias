---
// "Diseño de marca" y "Motion Creativo": mismos textos y videos de la
// versión actual. Acá las paletas se integran con el resto del sitio:
// marca = violeta, motion = lima (ya no dorado/cian). Los videos se cargan
// recién cuando se acercan a la pantalla.
const items = [
  {
    id: "marca",
    tone: "violet",
    title: "Diseño de marca",
    text:
      "Una marca es mucho más que un logo. Es la forma en que tu negocio se presenta, se reconoce y se diferencia. Trabajamos esa identidad para que todo lo que comunica tu marca tenga sentido y coherencia.",
    video: "/branding/branding-video.mp4",
    poster: "/branding/branding-poster.jpg",
    flip: false,
  },
  {
    id: "motion",
    tone: "lime",
    title: "Motion Creativo",
    text:
      "Transformo conceptos estáticos en piezas dinámicas que capturan la atención — pensadas para redes, presentaciones y eventos en vivo.",
    video: "/motion/motion-video.mp4",
    poster: "/motion/motion-poster.jpg",
    flip: true,
  },
];
---

<section class="vsh" id="marca-motion">
  {items.map((it) => (
    <article class:list={["vsh__row", `vsh__row--${it.tone}`, { "vsh__row--flip": it.flip }]} id={it.id}>
      <div class="vsh__glow" aria-hidden="true"></div>
      <div class="v2-container vsh__grid">
        <div class="vsh__media" data-reveal={it.flip ? "right" : "left"}>
          <div class="vsh__frame" data-tilt data-parallax="0.06">
            <span class="vsh__spin" aria-hidden="true"></span>
            <div class="vsh__inner">
              <video
                class="vsh__video"
                data-src={it.video}
                poster={it.poster}
                muted
                loop
                playsinline
                preload="none"
                aria-label={it.title}></video>
            </div>
          </div>
          <span class="vsh__dot vsh__dot--a" aria-hidden="true"></span>
          <span class="vsh__dot vsh__dot--b" aria-hidden="true"></span>
        </div>

        <div class="vsh__body" data-reveal={it.flip ? "left" : "right"} style="--d:2">
          <h2 class="v2-title vsh__title">{it.title}</h2>
          <p class="v2-lead">{it.text}</p>
        </div>
      </div>
    </article>
  ))}
</section>

<style>
  .vsh__row {
    --tone: var(--accent);
    --tone-2: var(--accent-2);
    position: relative;
    padding: 110px 0;
    overflow: hidden;
  }

  .vsh__row--violet {
    --tone: var(--accent);
    --tone-2: color-mix(in srgb, var(--accent) 55%, #fff);
    background: linear-gradient(180deg, var(--bg) 0%, color-mix(in srgb, var(--accent) 12%, var(--bg)) 100%);
  }

  .vsh__row--lime {
    --tone: var(--accent-2);
    --tone-2: var(--accent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 12%, var(--bg)) 0%, var(--bg) 100%);
  }

  .vsh__glow {
    position: absolute;
    width: 56vw;
    height: 56vw;
    max-width: 720px;
    max-height: 720px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--tone) 50%, transparent);
    filter: blur(110px);
    opacity: 0.32;
    top: 50%;
    left: 4%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .vsh__row--flip .vsh__glow {
    left: auto;
    right: 4%;
  }

  .vsh__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 72px;
  }

  .vsh__row--flip .vsh__media {
    order: 2;
  }

  .vsh__media {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* marco: borde que gira (solo transform → liviano en celulares) */
  .vsh__frame {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 1;
    border-radius: 28px;
    overflow: hidden;
    padding: 3px;
    transform: translate3d(0, var(--par, 0px), 0) perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    box-shadow: 0 40px 90px -30px color-mix(in srgb, var(--tone) 60%, transparent);
  }

  .vsh__spin {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 160%;
    aspect-ratio: 1;
    margin: -80% 0 0 -80%;
    background: conic-gradient(from 0deg, transparent 0 55%, var(--tone) 78%, var(--tone-2) 92%, transparent 100%);
    animation: vshSpin 7s linear infinite;
    will-change: transform;
  }

  .vsh__inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 25px;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .vsh__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vsh__dot {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    animation: vshFloat 6s ease-in-out infinite alternate;
  }

  .vsh__dot--a {
    width: 18px;
    height: 18px;
    top: 8%;
    right: 4%;
    background: var(--tone);
    box-shadow: 0 0 24px var(--tone);
  }

  .vsh__dot--b {
    width: 10px;
    height: 10px;
    bottom: 10%;
    left: 2%;
    background: var(--tone-2);
    box-shadow: 0 0 18px var(--tone-2);
    animation-delay: -3s;
  }

  .vsh__title {
    margin-bottom: 22px;
    font-size: clamp(32px, 5.2vw, 58px);
  }

  .vsh__row--lime .vsh__title {
    color: #fff;
    text-shadow: 0 0 40px color-mix(in srgb, var(--accent-2) 30%, transparent);
  }

  .vsh__body {
    position: relative;
  }

  .vsh__body::before {
    content: "";
    display: block;
    width: 64px;
    height: 4px;
    margin-bottom: 26px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--tone), var(--tone-2));
  }

  @keyframes vshSpin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes vshFloat {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -16px, 0);
    }
  }

  @media (max-width: 860px) {
    .vsh__row {
      padding: 72px 0;
    }

    .vsh__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .vsh__row--flip .vsh__media {
      order: 0;
    }

    .vsh__frame {
      max-width: 380px;
    }

    .vsh__glow {
      width: 90vw;
      height: 90vw;
      left: 5%;
      filter: blur(80px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vsh__spin,
    .vsh__dot {
      animation: none;
    }
  }
</style>
