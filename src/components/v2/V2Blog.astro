---
import { posts } from "../../data/blog.js";

const items = posts.slice(0, 3);
// las fechas pendientes ("TODO: fecha") no se muestran en esta versión
const hasDate = (d: string) => d && !d.toUpperCase().startsWith("TODO");
---

<section class="vb" id="blog">
  <div class="v2-container">
    <div class="vb__head">
      <div data-reveal>
        <p class="v2-eyebrow">Blog</p>
        <h2 class="v2-title">Un poco de <em>todo</em></h2>
        <p class="v2-lead vb__sub">
          Acá comparto información sobre, diseño, inteligencia artificial, las
          herramientas que uso en mi día a día y mucho más.
        </p>
      </div>
      <a href="/blog" class="v2-btn" data-reveal style="--d:2">Ver todo el blog →</a>
    </div>

    <div class="vb__grid">
      {items.map((post, i) => (
        <a href={post.link || "#"} class="vb__card" data-reveal style={`--d:${i}`} data-tilt data-spot>
          <span class="vb__shine" aria-hidden="true"></span>
          <div class="vb__img">
            <img src={post.image} alt={post.title} loading="lazy" />
          </div>
          <div class="vb__body">
            {hasDate(post.date) && <p class="vb__date">{post.date}</p>}
            <h3 class="vb__title">{post.title}</h3>
            <p class="vb__excerpt">{post.excerpt}</p>
            <span class="vb__more">Leer →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .vb {
    padding: 100px 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 10%, var(--bg)) 0%, var(--bg) 100%);
  }

  .vb__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 48px;
  }

  .vb__sub {
    max-width: 560px;
    margin-top: 18px;
  }

  .vb__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .vb__card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    text-decoration: none;
    color: var(--text);
    transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: border-color 0.3s ease, box-shadow 0.4s ease;
  }

  .vb__card:hover {
    border-color: var(--accent-2);
    box-shadow: 0 26px 60px -34px color-mix(in srgb, var(--accent-2) 60%, transparent);
  }

  .vb__shine {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%);
    pointer-events: none;
  }

  .vb__card:hover .vb__shine {
    opacity: 1;
  }

  .vb__img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 50%, var(--bg-elevated));
  }

  .vb__img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .vb__card:hover .vb__img img {
    transform: scale(1.06);
  }

  .vb__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px 24px 26px;
  }

  .vb__date {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-2);
  }

  .vb__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.15;
    text-transform: uppercase;
    color: #fff;
  }

  .vb__excerpt {
    margin: 0 0 18px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-muted);
    flex: 1;
  }

  .vb__more {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-2);
  }

  @media (max-width: 960px) {
    .vb__grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
      margin: 0 auto;
    }
  }

  @media (max-width: 720px) {
    .vb {
      padding: 72px 0;
    }

    .vb__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      margin-bottom: 32px;
    }
  }
</style>
