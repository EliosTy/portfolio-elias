---
// Header de la versión 2: transparente arriba, se vuelve vidrio al bajar,
// barra de progreso de lectura y menú a pantalla completa en el celular.
const links = [
  { href: "#inicio", label: "Inicio" },
  { href: "#trabajo", label: "Trabajos" },
  { href: "#servicios", label: "Servicios" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#contacto", label: "Contacto" },
];

const socials = [
  { href: "https://www.instagram.com/tyspace.com.ar/", label: "Instagram", icon: "ig" },
  { href: "https://www.linkedin.com/in/elias-villarruel-a430a2242/", label: "LinkedIn", icon: "in" },
];
---

<header class="vhd" id="v2-header">
  <div class="vhd__progress" aria-hidden="true"><i></i></div>

  <div class="v2-container vhd__inner">
    <a href="#inicio" class="vhd__logo" aria-label="TySpace — inicio">
      <img src="/logos/tyspace-slogan.svg" alt="TySpace — Potenciá tu marca" width="199" height="48" />
    </a>

    <nav class="vhd__nav" aria-label="Principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="vhd__right">
      <div class="vhd__socials">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class:list={["vhd__social", `vhd__social--${s.icon}`]}>
            {s.icon === "ig" ? (
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            ) : (
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3" y="3" width="18" height="18" rx="3" />
                <line x1="8" y1="10" x2="8" y2="17" />
                <circle cx="8" cy="7" r="1" fill="currentColor" stroke="none" />
                <path d="M12 17v-4.5a2.5 2.5 0 0 1 5 0V17" />
              </svg>
            )}
          </a>
        ))}
      </div>

      <button class="vhd__burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="v2-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="vhd__menu" id="v2-menu" aria-hidden="true">
    <nav aria-label="Menú">
      {links.map((l, i) => (
        <a href={l.href} style={`--i:${i}`}>{l.label}</a>
      ))}
      <a
        href={socials[1].href}
        target="_blank"
        rel="noopener"
        class="vhd__menu-social"
        style={`--i:${links.length}`}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3" />
          <line x1="8" y1="10" x2="8" y2="17" />
          <circle cx="8" cy="7" r="1" fill="currentColor" stroke="none" />
          <path d="M12 17v-4.5a2.5 2.5 0 0 1 5 0V17" />
        </svg>
        LinkedIn
      </a>
    </nav>
  </div>
</header>

<style>
  .vhd {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    transition: background 0.35s ease, backdrop-filter 0.35s ease, border-color 0.35s ease;
    border-bottom: 1px solid transparent;
  }

  .vhd.is-scrolled {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }

  /* con el menú abierto no puede haber backdrop-filter en el header: haría
     que el menú "fixed" se midiera contra el header y no contra la pantalla */
  .vhd.is-open,
  .vhd.is-open.is-scrolled {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .vhd__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    pointer-events: none;
  }

  .vhd__progress i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform-origin: 0 50%;
    transform: scaleX(var(--v2-progress, 0));
  }

  .vhd__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 72px;
    position: relative;
    z-index: 2;
  }

  .vhd__logo img {
    display: block;
    height: 44px;
    width: auto;
  }

  .vhd__nav {
    display: flex;
    gap: 6px;
    flex: 1;
    justify-content: center;
  }

  .vhd__nav a {
    position: relative;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .vhd__nav a::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 3px;
    height: 2px;
    background: var(--accent-2);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.3s ease;
  }

  .vhd__nav a:hover {
    color: #fff;
  }

  .vhd__nav a:hover::after {
    transform: scaleX(1);
  }

  .vhd__right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .vhd__socials {
    display: flex;
    gap: 10px;
  }

  .vhd__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .vhd__social:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  /* ---------- hamburguesa + menú móvil ---------- */
  .vhd__burger {
    display: none;
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: transparent;
    cursor: pointer;
  }

  .vhd__burger span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .vhd__burger span:nth-child(1) {
    top: 16px;
  }

  .vhd__burger span:nth-child(2) {
    top: 24px;
  }

  .vhd.is-open .vhd__burger span:nth-child(1) {
    transform: translateY(4px) rotate(45deg);
  }

  .vhd.is-open .vhd__burger span:nth-child(2) {
    transform: translateY(-4px) rotate(-45deg);
  }

  .vhd__menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 96px 24px 40px;
    background:
      radial-gradient(70% 50% at 80% 10%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%),
      var(--bg);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
  }

  .vhd.is-open .vhd__menu {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease;
  }

  .vhd__menu nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
    max-width: 420px;
  }

  .vhd__menu a {
    font-family: var(--font-display);
    font-size: clamp(28px, 9vw, 40px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: #fff;
    padding: 6px 0;
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.2s ease;
    transition-delay: calc(var(--i) * 60ms + 80ms);
  }

  .vhd.is-open .vhd__menu a {
    opacity: 1;
    transform: none;
  }

  .vhd__menu a:hover {
    color: var(--accent-2);
  }

  /* LinkedIn dentro del menú móvil (en el header queda solo Instagram) */
  .vhd__menu .vhd__menu-social {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .vhd__nav,
    .vhd__social--in {
      display: none;
    }

    .vhd__burger {
      display: block;
    }

    .vhd__inner {
      height: 64px;
    }

    .vhd__logo img {
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vhd__menu a {
      transition: none;
      transform: none;
    }
  }
</style>
