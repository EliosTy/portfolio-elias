---
// Sobre mí: la foto con órbitas y los párrafos que se iluminan uno a uno
// mientras bajás (sin JavaScript se ven todos encendidos).
const paragraphs = [
  "Hay ideas que solo necesitan un lugar para empezar.",
  "TY significa Thank You. Agradecer lo que nos inspira, las oportunidades que nos impulsan y a quienes hacen posible cada proyecto.",
  "SPACE es el lugar donde todo empieza. Una pantalla. Una conversación. Una hoja en blanco. Un proyecto.",
  "Porque crear también es compartir.",
  "Y cuando compartimos, las ideas pueden ir más lejos.",
];
---

<section class="vab" id="sobre-mi">
  <div class="v2-container vab__grid">
    <div class="vab__media" data-reveal="zoom">
      <div class="vab__orbit vab__orbit--1" aria-hidden="true"><i></i></div>
      <div class="vab__orbit vab__orbit--2" aria-hidden="true"><i></i></div>
      <div class="vab__photo" data-parallax="0.04">
        <img src="/about/foto-elias.png" alt="Foto de Elias" width="900" height="900" loading="lazy" />
      </div>
    </div>

    <div class="vab__body">
      <p class="v2-eyebrow" data-reveal>Elias Villarruel</p>
      {paragraphs.map((p, i) => (
        <p class="vab__p" data-lit>{p}</p>
      ))}
      <p class="vab__sign" data-lit>Gracias por el espacio :)</p>
    </div>
  </div>
</section>

<style>
  .vab {
    padding: 110px 0;
    background:
      radial-gradient(50% 50% at 90% 40%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%),
      var(--bg);
  }

  .vab__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 80px;
    align-items: center;
  }

  .vab__media {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
    aspect-ratio: 1;
  }

  .vab__photo {
    position: absolute;
    inset: 9%;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid color-mix(in srgb, var(--accent) 70%, var(--border));
    box-shadow: 0 0 80px -10px color-mix(in srgb, var(--accent) 70%, transparent);
    transform: translate3d(0, var(--par, 0px), 0);
  }

  .vab__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vab__orbit {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    pointer-events: none;
  }

  .vab__orbit i {
    position: absolute;
    border-radius: 50%;
    top: -6px;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    background: var(--accent-2);
    box-shadow: 0 0 16px var(--accent-2);
  }

  .vab__orbit--1 {
    inset: 0;
    animation: vabSpin 22s linear infinite;
  }

  .vab__orbit--2 {
    inset: 20px -20px -20px 20px;
    border-style: solid;
    border-color: color-mix(in srgb, var(--accent) 20%, transparent);
    animation: vabSpin 34s linear infinite reverse;
  }

  .vab__orbit--2 i {
    background: var(--accent);
    box-shadow: 0 0 16px var(--accent);
    width: 9px;
    height: 9px;
    margin-left: -4px;
    top: -4px;
  }

  .vab__body {
    max-width: 560px;
  }

  .vab__p {
    margin: 0 0 22px;
    font-size: clamp(19px, 2.6vw, 26px);
    line-height: 1.45;
    font-weight: 500;
    color: #fff;
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .vab__sign {
    margin: 30px 0 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 3.4vw, 32px);
    color: var(--accent-2);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* con JS: los párrafos fuera del centro de la pantalla se apagan */
  .v2-js .vab [data-lit] {
    opacity: 0.28;
  }

  .v2-js .vab [data-lit].is-lit {
    opacity: 1;
  }

  @keyframes vabSpin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 860px) {
    .vab {
      padding: 72px 0;
    }

    .vab__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
    }

    .vab__media {
      max-width: 300px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vab__orbit {
      animation: none;
    }

    .v2-js .vab [data-lit] {
      opacity: 1;
    }
  }
</style>
