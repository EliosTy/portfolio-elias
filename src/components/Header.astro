---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/trabajos", label: "Trabajos" },
  { href: "/#servicios", label: "Servicios" },
  { href: "/blog", label: "Blog" },
  { href: "/#contacto", label: "Contacto" },
];

// TODO: reemplazá por tus links reales de Instagram / LinkedIn (o el que uses).
const socials = [
  { href: "https://instagram.com/tu_usuario", label: "Instagram", icon: "ig" },
  { href: "https://linkedin.com/in/tu_usuario", label: "LinkedIn", icon: "in" },
];
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <img src="/logos/tyspace-slogan.svg" alt="TySpace — Diseño gráfico y branding" width="151" height="38" />
    </a>
    <nav class="header__nav">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <div class="header__socials">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="header__social-icon">
          {s.icon === "ig" ? (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          ) : (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <line x1="8" y1="10" x2="8" y2="17" />
              <circle cx="8" cy="7" r="1" fill="currentColor" stroke="none" />
              <path d="M12 17v-4.5a2.5 2.5 0 0 1 5 0V17" />
            </svg>
          )}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 24px;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .header__logo img {
    display: block;
    height: 38px;
    width: auto;
  }

  .header__logo:hover {
    opacity: 0.8;
  }

  .header__nav {
    display: flex;
    gap: 28px;
    flex: 1;
    justify-content: center;
  }

  .header__nav a {
    text-decoration: none;
    font-size: 14px;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .header__nav a:hover {
    color: var(--accent-2, var(--text));
  }

  .header__socials {
    display: flex;
    gap: 12px;
  }

  .header__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .header__social-icon:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  @media (max-width: 720px) {
    .header__nav {
      display: none;
    }
  }
</style>
