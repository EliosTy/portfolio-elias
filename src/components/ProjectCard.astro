---
const { project } = Astro.props;
---

<article class="card" data-category={project.category}>
  <a href={`/trabajos/${project.slug}`} class="card__link">
    <div class="card__image">
      <img src={project.image} alt={project.title} loading="lazy" />
    </div>

    <div class="card__tags">
      {project.tags.slice(0, 2).map((tag: string) => (
        <span class="card__tag">{tag}</span>
      ))}
    </div>

    <div class="card__name-bar">
      <span class="card__name">{project.title}</span>
    </div>
  </a>
</article>

<style>
  .card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card__link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
  }

  .card__image {
    position: absolute;
    inset: 0;
  }

  .card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .card__image img {
    transform: scale(1.04);
  }

  .card__tags {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 80%;
  }

  .card__tag {
    font-size: 11px;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(11, 6, 22, 0.55);
    backdrop-filter: blur(6px);
    color: var(--text);
    white-space: nowrap;
  }

  .card__name-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 20px;
    background: rgba(11, 6, 22, 0.35);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card__name {
    font-family: var(--font-serif-italic);
    font-style: italic;
    font-weight: 500;
    font-size: 19px;
    color: var(--text);
  }
</style>
