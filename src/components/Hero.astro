---
// orden de protagonismo: Photoshop > Illustrator > After Effects > Premiere
// (tamaño y delay de la animación van bajando en ese orden). Los archivos
// van en /public/images/icons/, 256x256px con fondo transparente.
//
// cada ícono tiene su propia duración, amplitud de movimiento, y un
// pequeño "respiro" de escala/opacidad en el punto más alto — así no se
// mueven todos igual ni sincronizados, se ve más orgánico.
const tools = [
  { label: "Photoshop", file: "photoshop.png", top: "5%", left: "60%", rotate: "-8deg", delay: "0s", size: 64, duration: "5.5s", amp: "16px", scalePeak: "1.05", opacityPeak: "0.9" },
  { label: "DaVinci Resolve", file: "davinci.png", top: "10%", left: "88%", rotate: "5deg", delay: "0.9s", size: 40, duration: "6.8s", amp: "9px", scalePeak: "1.04", opacityPeak: "0.85" },
  { label: "Illustrator", file: "ilustrator.png", top: "34%", left: "82%", rotate: "6deg", delay: "0.4s", size: 58, duration: "7.2s", amp: "10px", scalePeak: "1.03", opacityPeak: "0.85" },
  { label: "ComfyUI", file: "comfyui.png", top: "42%", left: "58%", rotate: "-6deg", delay: "2.1s", size: 42, duration: "7.8s", amp: "11px", scalePeak: "1.04", opacityPeak: "0.86" },
  { label: "After Effects", file: "after-effects.png", top: "58%", left: "92%", rotate: "-5deg", delay: "1s", size: 54, duration: "6.4s", amp: "13px", scalePeak: "1.06", opacityPeak: "0.92" },
  { label: "Xcode", file: "xcode.png", top: "70%", left: "66%", rotate: "7deg", delay: "1.3s", size: 44, duration: "6s", amp: "12px", scalePeak: "1.05", opacityPeak: "0.88" },
  { label: "Premiere", file: "premiere.png", top: "82%", left: "86%", rotate: "4deg", delay: "1.6s", size: 48, duration: "8s", amp: "9px", scalePeak: "1.04", opacityPeak: "0.88" },
];
---

<section class="hero">
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__floaters" aria-hidden="true">
    {tools.map((tool) => (
      <span
        class="tool-icon-wrap"
        style={`top:${tool.top}; left:${tool.left}; width:${tool.size}px; height:${tool.size}px; --rotate:${tool.rotate}; --amp:${tool.amp}; --scale-peak:${tool.scalePeak}; --opacity-peak:${tool.opacityPeak}; animation-duration:${tool.duration}; animation-delay:${tool.delay};`}
      >
        <span class="tool-icon-glow"></span>
        <img
          class="tool-icon"
          src={`/images/icons/${tool.file}`}
          alt=""
          width={tool.size}
          height={tool.size}
        />
      </span>
    ))}
  </div>

  <div class="hero__inner container">
    <div class="hero__copy">
      <h1 class="hero__title">
        <span class="hero__title-line">Que tu marca</span>
        <span class="hero__title-line hero__title-line--accent">no sea una más.</span>
      </h1>

      <p class="hero__subtitle">
        Con más de 6 años de experiencia en diseño gráfico, ayudo a marcas
        a diferenciarse a través de la identidad visual, el branding y la
        animación.
      </p>

      <div class="hero__actions">
        <a href="#trabajo" class="btn btn-primary btn-hero btn-hero--cta">Ver trabajos</a>
        <a href="#contacto" class="btn btn-hero">Contacto</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* --hero-bg queda de fondo por si la imagen tarda en cargar o no está
       todavía; cuando pongas el archivo en /public/images/hero-banner.jpg
       se muestra automáticamente. */
    background-color: var(--hero-bg, var(--bg));
    background-image: url("/images/hero-banner.jpg");
    background-size: cover;
    /* la cara queda cerca del borde superior de tu banner — anclamos
       arriba para que el recorte vertical salga siempre de la parte de
       abajo (el fondo), nunca de la cabeza. */
    background-position: center top;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  /* degradé sobre la imagen para que el texto se lea bien sin importar qué
     colores tenga el banner — oscuro donde está el texto (izquierda),
     se aclara hacia la derecha para que se vea el banner. */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--bg) 92%, transparent) 0%,
      color-mix(in srgb, var(--bg) 78%, transparent) 35%,
      color-mix(in srgb, var(--bg) 35%, transparent) 65%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* iconos de programas flotando sobre el banner, del lado derecho donde
     se ve más la imagen (la izquierda queda tapada por el degradé para
     que se lea el texto). */
  .hero__floaters {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* --- optimizado para rendimiento ---
     antes el halo violeta se hacía con 4 capas de drop-shadow apiladas y
     ANIMADAS (interpolando blur/opacidad en cada cuadro, sobre la silueta
     alfa del PNG) — eso es carísimo de recalcular con 7 íconos a la vez
     en bucle infinito, y es lo que causaba el problema de rendimiento.

     ahora el halo es un simple gradiente radial (`.tool-icon-glow`) detrás
     del ícono: no usa `filter`, así que el navegador solo tiene que
     pintarlo una vez y después moverlo con el GPU (transform/opacity),
     igual de liviano que mover una imagen sola. El movimiento (rotar,
     flotar, escalar) ahora vive en el contenedor `.tool-icon-wrap`, y
     tanto el ícono como su halo se mueven juntos dentro de él. */
  .tool-icon-wrap {
    position: absolute;
    display: block;
    transform: rotate(var(--rotate));
    transform-origin: center;
    animation-name: float;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    will-change: transform, opacity;
    /* duration y delay los pone cada ícono por style inline, así no se
       mueven todos igual ni al mismo tiempo */
  }

  .tool-icon-glow {
    position: absolute;
    /* tercer intento: un radial-gradient hecho a mano (con "stops" fijos)
       puede mostrar bandas o un borde definido según cómo lo renderice
       cada pantalla/navegador — es difícil de afinar a ciegas. En vez de
       eso usamos box-shadow con blur: es la sombra nativa del navegador,
       ya viene resuelta para difuminarse de forma pareja sin bandas ni
       bordes, y al no depender de la silueta en alfa del PNG (como sí
       hace drop-shadow) es mucho más barata de calcular. border-radius
       acá le da a la sombra la misma forma redondeada que ya tienen los
       íconos (cuadrado con esquinas curvas), así el halo queda pegado a
       su silueta real en vez de ser un cuadrado perfecto. */
    inset: 0;
    z-index: 0;
    border-radius: 22%;
    box-shadow:
      0 0 10px 1px rgba(196, 148, 255, 0.4),
      0 0 20px 4px rgba(178, 112, 255, 0.22),
      0 0 32px 6px rgba(157, 77, 255, 0.12);
    pointer-events: none;
  }

  .tool-icon {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
  }

  @keyframes float {
    0%,
    100% {
      transform: rotate(var(--rotate)) translateY(0) scale(1);
      opacity: 1;
    }
    50% {
      transform: rotate(var(--rotate)) translateY(calc(-1 * var(--amp))) scale(var(--scale-peak));
      opacity: var(--opacity-peak);
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    padding: 96px 24px;
    min-height: 640px;
  }

  .hero__copy {
    max-width: 620px;
  }

  .hero__title {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hero__title-line--accent {
    color: var(--accent-2);
  }

  .hero__subtitle {
    margin-top: 24px;
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    margin-top: 36px;
  }

  .btn-hero {
    text-transform: uppercase;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.03em;
    padding: 14px 26px;
  }

  /* mismo naranja que el botón "Consultar" de Servicios y "Enviar" del
     formulario de contacto (--cta-accent, definido en global.css) */
  .btn-hero--cta {
    background: var(--cta-accent);
    border-color: var(--cta-accent);
    color: #fff;
  }

  .btn-hero--cta:hover {
    background: var(--cta-accent);
    border-color: var(--cta-accent);
    color: #fff;
    opacity: 0.85;
  }

  @media (max-width: 860px) {
    .hero__inner {
      padding: 64px 24px;
      min-height: 460px;
    }

    /* en pantallas angostas el banner se recorta bastante — subimos el
       fondo más opaco para que el texto siga siendo legible aunque se vea
       menos banner de fondo. */
    .hero__overlay {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg) 92%, transparent) 0%,
        color-mix(in srgb, var(--bg) 82%, transparent) 55%,
        color-mix(in srgb, var(--bg) 60%, transparent) 100%
      );
    }

    /* con tan poco ancho los iconos flotantes quedan encima del texto o
       se pierden contra el fondo más oscuro — se ocultan en mobile. */
    .hero__floaters {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-icon-wrap {
      animation: none;
    }
  }
</style>
