---
// banner principal. Fondo espacial hecho 100% con CSS (sin imágenes ni
// canvas): nebulosa estática + campo de estrellas en capas que se desplaza
// muy lento + algunas estrellas que titilan + un par de estrellas fugaces.
//
// --- pensado para rendimiento ---
//  - todo el movimiento es transform/opacity sobre capas propias, así corre
//    en el GPU y no obliga al navegador a recalcular estilos ni layout.
//  - las estrellas son gradientes radiales en mosaico: se pintan una vez y
//    después solo se mueven. Nada de filter/blur animados.
//  - la nebulosa y el planeta son estáticos (se pintan una sola vez).
//  - en celular se usan menos capas y se apagan las estrellas fugaces.
//  - la animación se pausa cuando el banner sale de pantalla (ver script
//    abajo) y se desactiva con "reducir movimiento" del sistema.
---

<section class="hero">
  <div class="space" aria-hidden="true">
    <div class="stars stars--far"></div>
    <div class="stars stars--mid"></div>
    <div class="stars stars--near"></div>
    <div class="twinkle twinkle--a"></div>
    <div class="twinkle twinkle--b"></div>
    <div class="planet"></div>
    <span class="meteor meteor--a"></span>
    <span class="meteor meteor--b"></span>
  </div>

  <div class="hero__inner container">
    <div class="hero__copy">
      <h1 class="hero__title">
        <span class="hero__title-line">Que tu marca</span>
        <span class="hero__title-line hero__title-line--accent">no sea una más.</span>
      </h1>

      <p class="hero__subtitle">
        Con más de 6 años de experiencia en diseño gráfico, ayudo a marcas
        a diferenciarse a través de la identidad visual, el branding y la
        animación.
      </p>

      <div class="hero__actions">
        <a href="#contacto" class="btn btn-primary btn-hero btn-hero--cta">Contacto</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* nebulosa estática: tres manchas de color (violeta arriba a la
       derecha, violeta suave abajo, un toque de verde marca abajo a la
       izquierda) sobre un fondo casi negro. Se pinta una sola vez. */
    background:
      radial-gradient(60% 85% at 86% 12%, color-mix(in srgb, var(--accent) 36%, transparent) 0%, transparent 70%),
      radial-gradient(55% 70% at 52% 118%, color-mix(in srgb, var(--accent) 24%, transparent) 0%, transparent 72%),
      radial-gradient(45% 60% at 4% 105%, color-mix(in srgb, var(--accent-2) 11%, transparent) 0%, transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg) 62%, #000) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .space {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
  }

  /* --- campo de estrellas en capas (parallax) ---
     cada capa es más ancha que el banner por exactamente un "mosaico" y se
     desliza un mosaico hacia la izquierda en bucle: como el patrón se repite
     cada --tile, el reinicio es invisible. Más lejos = más chico, más
     tenue y más lento. */
  .stars {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: calc(100% + var(--tile));
    background-repeat: repeat;
    background-size: var(--tile) var(--tile);
    will-change: transform;
    animation: drift var(--speed) linear infinite;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-1 * var(--tile)), 0, 0);
    }
  }

  .stars--far {
    --tile: 320px;
    --speed: 150s;
    background-image:
      radial-gradient(circle at 24px 38px, rgba(255, 255, 255, 0.5) 0.6px, transparent 1.1px),
      radial-gradient(circle at 97px 210px, rgba(255, 255, 255, 0.45) 0.6px, transparent 1.1px),
      radial-gradient(circle at 150px 90px, rgba(255, 255, 255, 0.5) 0.6px, transparent 1.1px),
      radial-gradient(circle at 212px 276px, rgba(255, 255, 255, 0.4) 0.6px, transparent 1.1px),
      radial-gradient(circle at 268px 140px, rgba(255, 255, 255, 0.5) 0.6px, transparent 1.1px),
      radial-gradient(circle at 300px 20px, rgba(255, 255, 255, 0.45) 0.6px, transparent 1.1px),
      radial-gradient(circle at 60px 150px, rgba(255, 255, 255, 0.4) 0.6px, transparent 1.1px),
      radial-gradient(circle at 180px 170px, rgba(255, 255, 255, 0.5) 0.6px, transparent 1.1px),
      radial-gradient(circle at 120px 300px, rgba(255, 255, 255, 0.45) 0.6px, transparent 1.1px),
      radial-gradient(circle at 250px 60px, rgba(255, 255, 255, 0.4) 0.6px, transparent 1.1px),
      radial-gradient(circle at 10px 250px, rgba(255, 255, 255, 0.5) 0.6px, transparent 1.1px),
      radial-gradient(circle at 75px 95px, rgba(255, 255, 255, 0.4) 0.6px, transparent 1.1px);
  }

  .stars--mid {
    --tile: 480px;
    --speed: 95s;
    background-image:
      radial-gradient(circle at 40px 60px, rgba(255, 255, 255, 0.75) 0.9px, transparent 1.6px),
      radial-gradient(circle at 130px 300px, rgba(220, 200, 255, 0.7) 0.9px, transparent 1.6px),
      radial-gradient(circle at 210px 150px, rgba(255, 255, 255, 0.7) 0.9px, transparent 1.6px),
      radial-gradient(circle at 300px 420px, rgba(255, 255, 255, 0.75) 0.9px, transparent 1.6px),
      radial-gradient(circle at 380px 90px, rgba(220, 200, 255, 0.7) 0.9px, transparent 1.6px),
      radial-gradient(circle at 440px 250px, rgba(255, 255, 255, 0.7) 0.9px, transparent 1.6px),
      radial-gradient(circle at 90px 430px, rgba(255, 255, 255, 0.75) 0.9px, transparent 1.6px),
      radial-gradient(circle at 260px 30px, rgba(255, 255, 255, 0.7) 0.9px, transparent 1.6px),
      radial-gradient(circle at 350px 330px, rgba(220, 200, 255, 0.7) 0.9px, transparent 1.6px);
  }

  .stars--near {
    --tile: 640px;
    --speed: 62s;
    background-image:
      radial-gradient(circle at 80px 120px, rgba(255, 255, 255, 1) 1.3px, transparent 2.2px),
      radial-gradient(circle at 250px 400px, rgba(210, 179, 255, 1) 1.3px, transparent 2.2px),
      radial-gradient(circle at 420px 70px, rgba(255, 255, 255, 1) 1.3px, transparent 2.2px),
      radial-gradient(circle at 560px 300px, rgba(200, 255, 128, 0.95) 1.3px, transparent 2.2px),
      radial-gradient(circle at 180px 560px, rgba(255, 255, 255, 1) 1.3px, transparent 2.2px),
      radial-gradient(circle at 500px 520px, rgba(210, 179, 255, 1) 1.3px, transparent 2.2px),
      radial-gradient(circle at 330px 230px, rgba(255, 255, 255, 1) 1.3px, transparent 2.2px);
  }

  /* --- estrellas que titilan ---
     dos capas fijas con pocas estrellas más grandes y con halo; solo
     cambia la opacidad de toda la capa (barato), cada una con su propio
     ritmo para que no latan al mismo tiempo. */
  .twinkle {
    position: absolute;
    inset: 0;
    background-repeat: repeat;
    background-size: 560px 560px;
    will-change: opacity;
    animation: twinkle var(--t, 4s) ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    from {
      opacity: 0.25;
    }
    to {
      opacity: 1;
    }
  }

  .twinkle--a {
    --t: 3.8s;
    background-image:
      radial-gradient(circle at 70px 90px, #fff 1px, rgba(255, 255, 255, 0.28) 2.4px, transparent 4.5px),
      radial-gradient(circle at 330px 40px, #fff 1px, rgba(255, 255, 255, 0.28) 2.4px, transparent 4.5px),
      radial-gradient(circle at 210px 380px, rgba(210, 179, 255, 1) 1px, rgba(210, 179, 255, 0.3) 2.4px, transparent 4.5px),
      radial-gradient(circle at 480px 300px, #fff 1px, rgba(255, 255, 255, 0.28) 2.4px, transparent 4.5px);
  }

  .twinkle--b {
    --t: 5.2s;
    animation-delay: -2.4s;
    background-position: 190px 130px;
    background-image:
      radial-gradient(circle at 120px 200px, #fff 1px, rgba(255, 255, 255, 0.28) 2.4px, transparent 4.5px),
      radial-gradient(circle at 400px 120px, rgba(200, 255, 128, 1) 1px, rgba(200, 255, 128, 0.3) 2.4px, transparent 4.5px),
      radial-gradient(circle at 300px 470px, #fff 1px, rgba(255, 255, 255, 0.28) 2.4px, transparent 4.5px);
  }

  /* --- planeta ---
     esfera oscura con luz violeta/verde en el borde, como en la portada
     del curso. Totalmente estática: un solo pintado. */
  .planet {
    position: absolute;
    right: -9%;
    bottom: -52%;
    width: min(640px, 56vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 24%, #2f1a5c 0%, #170c33 42%, #0a0519 78%);
    box-shadow:
      inset 14px 14px 42px -14px color-mix(in srgb, var(--accent-2) 55%, transparent),
      inset -40px -40px 90px rgba(0, 0, 0, 0.55),
      0 0 110px -10px color-mix(in srgb, var(--accent) 38%, transparent);
  }

  /* --- estrellas fugaces ---
     una línea fina que cruza en diagonal y pasa casi todo el ciclo
     invisible (se ve solo el primer ~8% del tiempo), cada una con su
     propio ritmo. */
  .meteor {
    position: absolute;
    width: 130px;
    height: 1.5px;
    border-radius: 2px;
    background: linear-gradient(90deg, #fff, rgba(255, 255, 255, 0));
    opacity: 0;
    will-change: transform, opacity;
    animation: meteor var(--m, 11s) linear infinite;
  }

  .meteor--a {
    --m: 11s;
    top: 14%;
    left: 80%;
    animation-delay: 3s;
  }

  .meteor--b {
    --m: 17s;
    top: 34%;
    left: 56%;
    animation-delay: 9s;
  }

  @keyframes meteor {
    0% {
      transform: translate3d(0, 0, 0) rotate(-25deg);
      opacity: 0;
    }
    1.5% {
      opacity: 1;
    }
    7% {
      transform: translate3d(-340px, 158px, 0) rotate(-25deg);
      opacity: 0;
    }
    100% {
      transform: translate3d(-340px, 158px, 0) rotate(-25deg);
      opacity: 0;
    }
  }

  /* cuando el banner sale de pantalla, se pausa todo (ver script) */
  .hero.is-offscreen .stars,
  .hero.is-offscreen .twinkle,
  .hero.is-offscreen .meteor {
    animation-play-state: paused;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    padding: 96px 24px;
    min-height: 640px;
  }

  .hero__copy {
    max-width: 620px;
  }

  .hero__title {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.05;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hero__title-line--accent {
    color: var(--accent-2);
  }

  .hero__subtitle {
    margin-top: 24px;
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    margin-top: 36px;
  }

  .btn-hero {
    text-transform: uppercase;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.03em;
    padding: 14px 26px;
  }

  /* mismo naranja que el botón "Consultar" de Servicios y "Enviar" del
     formulario de contacto (--cta-accent, definido en global.css) */
  .btn-hero--cta {
    background: var(--cta-accent);
    border-color: var(--cta-accent);
    color: #fff;
  }

  .btn-hero--cta:hover {
    background: var(--cta-accent);
    border-color: var(--cta-accent);
    color: #fff;
    opacity: 0.85;
  }

  @media (max-width: 860px) {
    .hero__inner {
      padding: 64px 24px;
      min-height: 460px;
    }

    /* celular: menos capas y sin estrellas fugaces para cuidar batería y
       rendimiento; el planeta baja y se achica para no competir con el
       texto. */
    .stars--near,
    .twinkle--b,
    .meteor {
      display: none;
    }

    .planet {
      right: -22%;
      bottom: -34%;
      width: 78vw;
      opacity: 0.8;
    }
  }

  /* si el sistema pide reducir movimiento, queda el cielo quieto */
  @media (prefers-reduced-motion: reduce) {
    .stars,
    .twinkle,
    .meteor {
      animation: none;
    }

    .meteor {
      display: none;
    }
  }
</style>

<script>
  // pausa las animaciones del fondo cuando el banner no se ve (el usuario
  // ya scrolleó más abajo), así no gastan GPU/batería para nada.
  const hero = document.querySelector<HTMLElement>(".hero");
  if (hero && "IntersectionObserver" in window) {
    new IntersectionObserver(([entry]) => {
      hero.classList.toggle("is-offscreen", !entry.isIntersecting);
    }).observe(hero);
  }
</script>
