---
import { services } from "../data/services.js";
---

<section class="services section" id="servicios">
  <div class="container">
    <div class="services__header">
      <h2 class="services__title">Planes y servicios</h2>
    </div>

    <div class="services__divider" aria-hidden="true"></div>

    <div class="services__grid">
      {services.map((service) => (
        <div
          class:list={[
            "service-card",
            {
              "service-card--highlight": service.highlight,
              "service-card--gold": service.color === "gold",
              "service-card--cyan": service.color === "cyan",
            },
          ]}
        >
          {service.highlight && <span class="service-card__badge">Más completo</span>}

          <div class="service-card__head">
            <div class="service-card__icon">
              {service.icon === "flash" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z" />
                </svg>
              )}
              {service.icon === "star" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.8-4.6 6.6-.9L12 2.5z" />
                </svg>
              )}
              {service.icon === "trend" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 17l6-6 4 4 8-8" />
                  <path d="M15 7h6v6" />
                </svg>
              )}
              {service.icon === "crown" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8l4 3 5-6 5 6 4-3-2 10H5L3 8z" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="service-card__title">{service.title}</h3>
            </div>
          </div>

          <p class="service-card__description">{service.description}</p>

          {service.price ? (
            <p class="service-card__price">
              {service.price} <span>/{service.priceUnit}</span>
            </p>
          ) : (
            <p class="service-card__price service-card__price--consult">A consultar</p>
          )}

          <div class="service-card__line" aria-hidden="true"></div>

          <ul class="service-card__items">
            {service.items.map((item: string) => (
              <li>
                <span class="check-icon">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12l5 5 11-11" />
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>

          <a href="#contacto" class="btn service-card__cta">Consultar</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    /* mismo naranja que "Ver trabajos" del banner y "Enviar" del
       formulario de contacto (definido una sola vez en global.css como
       --cta-accent) */
    --services-accent: var(--cta-accent);
    /* sin marcos: cada tarjeta es un panel de color plano, igual que las
       secciones "Branding Creativo" (ServicesIntro.astro) y "Motion
       Creativo" (MotionIntro.astro) de más arriba — mismos colores
       exactos que esas dos, para que las tarjetas se sientan parte de la
       misma sección. Como el dorado y el lima son colores claros,
       necesitan texto oscuro (ink) para tener contraste, igual que ya
       resuelven esas dos secciones; el índigo de Motion es oscuro, así
       que ahí el texto claro del tema sigue funcionando. El Plan Premium
       no tiene una sección propia arriba, así que usa el lima de la
       marca (--accent-2) con el mismo criterio. */
    --branding-bg: #f3c000;
    --branding-ink: #1a1200;
    --branding-muted: #5c4a12;
    --motion-bg: #3c4799;
    --motion-muted: #c3c9ec;
    --premium-bg: #a6ff2e;
    --premium-ink: #16240a;
    --premium-muted: #45591f;
  }

  .services__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    text-align: center;
  }

  .services__title {
    font-size: clamp(32px, 5vw, 48px);
    text-transform: uppercase;
    text-align: center;
  }

  .services__divider {
    height: 1px;
    max-width: 640px;
    margin: 40px auto 48px;
    background: linear-gradient(
      to right,
      transparent,
      var(--accent-2) 35%,
      var(--accent) 65%,
      transparent
    );
    opacity: 0.6;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
    padding-top: 12px;
  }

  .service-card {
    position: relative;
    /* sin marcos: nada de border acá, el color plano de fondo es lo que
       define la tarjeta. */
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: opacity 0.25s ease, transform 0.25s ease, filter 0.25s ease;
  }

  /* al pasar el mouse por la grilla, la tarjeta apuntada se resalta y las
     demás se atenúan un poco */
  .services__grid:hover .service-card:not(:hover) {
    opacity: 0.55;
  }

  .service-card:hover {
    transform: translateY(-4px);
    filter: brightness(1.06);
  }

  /* tarjeta de Branding — mismo dorado plano que la sección "Branding
     Creativo" de arriba. Como es un color claro, título/descripción/
     íconos usan tinta oscura propia (--branding-ink / --branding-muted)
     en vez de los tokens claros del tema. */
  .service-card--gold {
    background: var(--branding-bg);
  }

  .service-card--gold .service-card__title,
  .service-card--gold .service-card__price {
    color: var(--branding-ink);
  }

  .service-card--gold .service-card__description,
  .service-card--gold .service-card__price span,
  .service-card--gold .service-card__price--consult {
    color: var(--branding-muted);
  }

  .service-card--gold .service-card__items li {
    color: var(--branding-ink);
  }

  .service-card--gold .service-card__icon,
  .service-card--gold .check-icon {
    border-color: var(--branding-ink);
    color: var(--branding-ink);
  }

  .service-card--gold .service-card__line {
    background: color-mix(in srgb, var(--branding-ink) 20%, transparent);
  }

  /* tarjeta de Motion — mismo índigo plano que "Motion Creativo". Es un
     color oscuro, así que el texto claro del tema sigue funcionando;
     solo el "muted" usa el tono frío propio de esa sección. */
  .service-card--cyan {
    background: var(--motion-bg);
  }

  .service-card--cyan .service-card__description,
  .service-card--cyan .service-card__price span,
  .service-card--cyan .service-card__price--consult {
    color: var(--motion-muted);
  }

  .service-card--cyan .service-card__icon,
  .service-card--cyan .check-icon {
    border-color: #fff;
    color: #fff;
  }

  .service-card--cyan .service-card__line {
    background: color-mix(in srgb, #fff 20%, transparent);
  }

  /* el plan destacado usa el lima de la marca como color plano — el
     mismo criterio que gold/cyan (color claro → tinta oscura propia). Se
     agranda un 13% y sube de z-index para resaltar sobre las demás. */
  .service-card--highlight {
    padding: 34px 32px;
    background: var(--premium-bg);
    transform: scale(1.13);
    transform-origin: center;
    z-index: 2;
  }

  .service-card--highlight .service-card__title,
  .service-card--highlight .service-card__price {
    color: var(--premium-ink);
    font-size: 19px;
  }

  .service-card--highlight .service-card__price {
    font-size: 28px;
  }

  .service-card--highlight .service-card__description,
  .service-card--highlight .service-card__price span,
  .service-card--highlight .service-card__price--consult {
    color: var(--premium-muted);
  }

  .service-card--highlight .service-card__items li {
    color: var(--premium-ink);
  }

  .service-card--highlight .service-card__icon,
  .service-card--highlight .check-icon {
    border-color: var(--premium-ink);
    color: var(--premium-ink);
  }

  .service-card--highlight .service-card__icon {
    width: 44px;
    height: 44px;
  }

  .service-card--highlight .service-card__line {
    background: color-mix(in srgb, var(--premium-ink) 20%, transparent);
  }

  .service-card--highlight:hover {
    transform: scale(1.13) translateY(-4px);
  }

  /* la etiqueta va dentro del padding de la tarjeta (no montada sobre el
     borde), así nunca queda cortada. Va en tinta oscura sobre un chip
     claro para que se lea sobre el lima de fondo. */
  .service-card__badge {
    position: relative;
    display: inline-block;
    align-self: flex-start;
    background: var(--premium-ink);
    color: var(--premium-bg);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border-radius: 999px;
    z-index: 1;
    margin-bottom: 12px;
  }

  .service-card__head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 1;
  }

  .service-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid currentColor;
    color: var(--text);
  }

  .service-card__title {
    font-size: 17px;
    line-height: 1.25;
    color: var(--text);
  }

  .service-card__description {
    position: relative;
    z-index: 1;
    font-size: 13px;
    color: var(--text-muted);
    margin: 10px 0 0;
  }

  .service-card__price {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    margin: 20px 0 0;
    color: var(--text);
  }

  .service-card__price span {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .service-card__price--consult {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-muted);
    font-style: italic;
    font-family: var(--font-serif-italic);
  }

  .service-card__line {
    height: 1px;
    background: color-mix(in srgb, var(--text) 20%, transparent);
    margin: 20px 0;
  }

  .service-card__items {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .service-card__items li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text);
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 5px;
    border: 1px solid var(--accent-2);
    color: var(--accent-2);
  }

  .service-card__cta {
    position: relative;
    z-index: 1;
    justify-content: center;
    align-self: stretch;
    text-align: center;
    gap: 6px;
    background: var(--services-accent);
    border-color: var(--services-accent);
    color: #fff;
    font-weight: 600;
  }

  .service-card__cta:hover {
    background: var(--services-accent);
    border-color: var(--services-accent);
    color: #fff;
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    /* en una sola columna el escalado se sale del ancho de pantalla, así
       que en mobile la tarjeta destacada se distingue solo por el trazo
       en degradé y la etiqueta, sin agrandarse. */
    .service-card--highlight {
      transform: none;
      margin: 8px 0;
    }

    .service-card--highlight:hover {
      transform: translateY(-4px);
    }
  }
</style>
