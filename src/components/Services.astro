---
import { services } from "../data/services.js";
---

<section class="services section" id="servicios">
  <div class="container">
    <div class="services__header">
      <h2 class="services__title">Planes y servicios</h2>
    </div>

    <div class="services__divider" aria-hidden="true"></div>

    <div class="services__grid">
      {services.map((service) => (
        <div
          class:list={[
            "service-card",
            {
              "service-card--highlight": service.highlight,
              "service-card--gold": service.color === "gold",
              "service-card--cyan": service.color === "cyan",
            },
          ]}
        >
          {service.highlight && <span class="service-card__badge">Más completo</span>}

          <div class="service-card__head">
            <div class="service-card__icon">
              {service.icon === "flash" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z" />
                </svg>
              )}
              {service.icon === "star" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.8-4.6 6.6-.9L12 2.5z" />
                </svg>
              )}
              {service.icon === "trend" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 17l6-6 4 4 8-8" />
                  <path d="M15 7h6v6" />
                </svg>
              )}
              {service.icon === "crown" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8l4 3 5-6 5 6 4-3-2 10H5L3 8z" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="service-card__title">{service.title}</h3>
            </div>
          </div>

          <p class="service-card__description">{service.description}</p>

          {service.price && (
            <p class="service-card__price">
              {service.price} <span>/{service.priceUnit}</span>
            </p>
          )}

          <div class="service-card__line" aria-hidden="true"></div>

          <ul class="service-card__items">
            {service.items.map((item: string) => (
              <li>
                <span class="check-icon">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12l5 5 11-11" />
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>

          {service.note && <p class="service-card__note">{service.note}</p>}

          <a href="#contacto" class="btn service-card__cta">Consultar</a>
        </div>
      ))}
    </div>

    <div class="services__footnote">
      <p class="services__footnote-title">No todas las marcas necesitan lo mismo.</p>
      <p class="services__footnote-text">Por eso cada presupuesto es personalizado. Adaptamos el servicio a lo que realmente necesita tu proyecto y cuidamos tu inversión.</p>
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    overflow: hidden;
    /* identidad de cada tarjeta: un color de acento (--card-accent) que
       se ve en el brillo del fondo, en el ícono, el check y el botón; y
       una tinta oscura (--card-ink) solo para el texto que va ARRIBA de
       ese color sólido (badge y botón). El resto del texto de la
       tarjeta usa siempre los tokens claros del tema, porque ahora el
       fondo de la tarjeta es vidrio oscuro, no un panel de color plano. */
    --branding-accent: #f3c000; /* amarillo — Diseño de marca */
    --branding-ink: #1a1200;
    --premium-accent: var(--accent-2); /* verde lima de la marca — Premium */
    --premium-ink: #16240a;
    --motion-accent: #74c6ff; /* celeste — Motion */
    --motion-ink: #062a44;
  }

  /* motitas de estrellas muy sutiles detrás de las tarjetas: al tener
     vidrio esmerilado (blur) encima, se ven como un leve bokeh borroso
     — un guiño a la temática de espacio sin competir con el contenido. */
  .services::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.7;
    pointer-events: none;
    background-image:
      radial-gradient(1.5px 1.5px at 8% 20%, rgba(255, 255, 255, 0.55), transparent),
      radial-gradient(1px 1px at 22% 65%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1.5px 1.5px at 35% 12%, rgba(255, 255, 255, 0.35), transparent),
      radial-gradient(1px 1px at 48% 80%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(2px 2px at 60% 30%, rgba(166, 255, 46, 0.3), transparent),
      radial-gradient(1px 1px at 72% 55%, rgba(255, 255, 255, 0.35), transparent),
      radial-gradient(1.5px 1.5px at 84% 18%, rgba(157, 77, 255, 0.35), transparent),
      radial-gradient(1px 1px at 92% 70%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1.5px 1.5px at 15% 90%, rgba(255, 255, 255, 0.3), transparent),
      radial-gradient(1px 1px at 65% 95%, rgba(255, 255, 255, 0.3), transparent);
  }

  .services .container {
    position: relative;
    z-index: 1;
  }

  .services__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    text-align: center;
  }

  .services__title {
    font-size: clamp(32px, 5vw, 48px);
    text-transform: uppercase;
    text-align: center;
  }

  .services__divider {
    height: 1px;
    max-width: 640px;
    margin: 40px auto 48px;
    background: linear-gradient(
      to right,
      transparent,
      var(--accent-2) 35%,
      var(--accent) 65%,
      transparent
    );
    opacity: 0.6;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
    padding-top: 12px;
  }

  /* "liquid glass": vidrio esmerilado oscuro y translúcido (blur +
     saturate sobre lo que hay detrás), con un borde muy fino que
     insinúa el filo de un cristal — brillo arriba, sombra abajo — en
     vez del panel de color plano de antes. */
  .service-card {
    position: relative;
    isolation: isolate;
    border-radius: 22px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: linear-gradient(
      165deg,
      rgba(255, 255, 255, 0.1),
      rgba(255, 255, 255, 0.03) 45%,
      rgba(255, 255, 255, 0.06)
    );
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 0 24px rgba(255, 255, 255, 0.03),
      0 24px 48px -28px rgba(0, 0, 0, 0.7);
    transition: opacity 0.25s ease, transform 0.25s ease, filter 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* el color identificatorio de cada tarjeta "se refleja" como un brillo
     que sube desde abajo — como si el vidrio dejara pasar un poco de luz
     de color desde atrás. Un degradé radial (no un filter: blur) para
     que quede siempre contenido dentro de la propia tarjeta, sin
     "derramarse" sobre lo que hay debajo. Va detrás del contenido
     (z-index de la tarjeta lo aísla con isolation: isolate). */
  .service-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      ellipse 90% 62% at 50% 118%,
      var(--card-accent, var(--accent-2)) 0%,
      transparent 68%
    );
    opacity: 0.6;
    transition: opacity 0.25s ease;
  }

  /* aclaración corta dentro de la tarjeta, arriba del botón. En itálica
     para diferenciarla del resto del contenido (ítems, descripción). */
  .service-card__note {
    position: relative;
    z-index: 1;
    font-size: 12.5px;
    font-style: italic;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 4px 0 16px;
  }

  /* al pasar el mouse por la grilla, la tarjeta apuntada se resalta y las
     demás se atenúan un poco */
  .services__grid:hover .service-card:not(:hover) {
    opacity: 0.55;
  }

  .service-card:hover {
    transform: translateY(-4px);
    filter: brightness(1.08);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 0 24px rgba(255, 255, 255, 0.05),
      0 28px 56px -26px rgba(0, 0, 0, 0.75);
  }

  .service-card:hover::before {
    opacity: 0.7;
  }

  .service-card--gold {
    --card-accent: var(--branding-accent);
    --card-ink: var(--branding-ink);
  }

  .service-card--cyan {
    --card-accent: var(--motion-accent);
    --card-ink: var(--motion-ink);
  }

  .service-card--highlight {
    --card-accent: var(--premium-accent);
    --card-ink: var(--premium-ink);
    padding: 34px 32px;
    border-color: color-mix(in srgb, var(--card-accent) 45%, rgba(255, 255, 255, 0.14));
    transform: scale(1.13);
    transform-origin: center;
    z-index: 2;
  }

  .service-card--highlight .service-card__title {
    font-size: 19px;
  }

  .service-card--highlight .service-card__price {
    font-size: 28px;
  }

  .service-card--highlight .service-card__icon {
    width: 44px;
    height: 44px;
  }

  .service-card--highlight:hover {
    transform: scale(1.13) translateY(-4px);
  }

  /* la etiqueta va dentro del padding de la tarjeta (no montada sobre el
     borde), así nunca queda cortada. Va en el color de acento de la
     tarjeta, con su tinta oscura — mismo criterio que el botón. */
  .service-card__badge {
    position: relative;
    display: inline-block;
    align-self: flex-start;
    background: var(--card-accent);
    color: var(--card-ink);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border-radius: 999px;
    z-index: 1;
    margin-bottom: 12px;
  }

  .service-card__head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 1;
  }

  /* el ícono toma el color de acento de la tarjeta — un segundo lugar,
     además del brillo de fondo y el botón, donde se nota la identidad
     de cada servicio. */
  .service-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--card-accent, currentColor);
    color: var(--card-accent, var(--text));
  }

  .service-card__title {
    position: relative;
    z-index: 1;
    font-size: 17px;
    line-height: 1.25;
    color: var(--text);
  }

  .service-card__description {
    position: relative;
    z-index: 1;
    font-size: 13px;
    color: var(--text-muted);
    margin: 10px 0 0;
  }

  .service-card__price {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    margin: 20px 0 0;
    color: var(--text);
  }

  .service-card__price span {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .service-card__price--consult {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-muted);
    font-style: italic;
    font-family: var(--font-serif-italic);
  }

  .service-card__line {
    position: relative;
    z-index: 1;
    height: 1px;
    background: color-mix(in srgb, var(--card-accent, var(--text)) 40%, transparent);
    margin: 20px 0;
  }

  .service-card__items {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .service-card__items li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text);
  }

  /* el check también toma el acento de la tarjeta en vez del lima fijo
     de antes, para reforzar la identidad de color en cada una. */
  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 5px;
    border: 1px solid var(--card-accent, var(--accent-2));
    color: var(--card-accent, var(--accent-2));
  }

  /* el botón pasa a usar el color de identidad de cada tarjeta (antes
     era el mismo naranja para las tres). */
  .service-card__cta {
    position: relative;
    z-index: 1;
    justify-content: center;
    align-self: stretch;
    text-align: center;
    gap: 6px;
    background: var(--card-accent, var(--cta-accent));
    border-color: var(--card-accent, var(--cta-accent));
    color: var(--card-ink, #fff);
    font-weight: 600;
  }

  .service-card__cta:hover {
    background: var(--card-accent, var(--cta-accent));
    border-color: var(--card-accent, var(--cta-accent));
    color: var(--card-ink, #fff);
    opacity: 0.85;
  }

  /* mensaje de cierre, debajo de toda la grilla: aclara que los precios
     "a consultar" son presupuestos a medida. */
  .services__footnote {
    max-width: 560px;
    margin: 56px auto 0;
    text-align: center;
  }

  /* título del bloque de cierre: grande y bold para que se note que es
     un título, pero más chico que "Planes y servicios" (el de la
     sección). */
  .services__footnote-title {
    font-size: clamp(22px, 3.2vw, 30px);
    font-weight: 800;
    text-align: center;
    color: var(--text);
    margin: 0 0 12px;
  }

  .services__footnote-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    /* en una sola columna el escalado se sale del ancho de pantalla, así
       que en mobile la tarjeta destacada se distingue solo por el trazo
       en degradé y la etiqueta, sin agrandarse. */
    .service-card--highlight {
      transform: none;
      margin: 8px 0;
    }

    .service-card--highlight:hover {
      transform: translateY(-4px);
    }
  }
</style>
