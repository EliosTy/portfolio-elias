---
import { services } from "../data/services.js";
---

<section class="services section" id="servicios">
  <div class="container">
    <div class="services__header">
      <h2 class="services__title">Planes y servicios</h2>
    </div>

    <div class="services__divider" aria-hidden="true"></div>

    <div class="services__grid">
      {services.map((service) => (
        <div class:list={["service-card", { "service-card--highlight": service.highlight }]}>
          {service.highlight && <span class="service-card__badge">Más completo</span>}

          <div class="service-card__head">
            <div class="service-card__icon">
              {service.icon === "flash" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z" />
                </svg>
              )}
              {service.icon === "star" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.8-4.6 6.6-.9L12 2.5z" />
                </svg>
              )}
              {service.icon === "trend" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 17l6-6 4 4 8-8" />
                  <path d="M15 7h6v6" />
                </svg>
              )}
              {service.icon === "crown" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8l4 3 5-6 5 6 4-3-2 10H5L3 8z" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="service-card__title">{service.title}</h3>
            </div>
          </div>

          <p class="service-card__description">{service.description}</p>

          {service.price ? (
            <p class="service-card__price">
              {service.price} <span>/{service.priceUnit}</span>
            </p>
          ) : (
            <p class="service-card__price service-card__price--consult">A consultar</p>
          )}

          <div class="service-card__line" aria-hidden="true"></div>

          <ul class="service-card__items">
            {service.items.map((item: string) => (
              <li>
                <span class="check-icon">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12l5 5 11-11" />
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>

          <a href="#contacto" class="btn service-card__cta">
            Consultar <span aria-hidden="true">↗</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    /* TODO: cambiá este naranja si más adelante querés otro tono */
    --services-accent: #ff7a30;
  }

  .services__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    text-align: center;
  }

  .services__title {
    font-size: clamp(32px, 5vw, 48px);
    text-transform: uppercase;
    text-align: center;
  }

  .services__divider {
    height: 1px;
    max-width: 640px;
    margin: 40px auto 48px;
    background: linear-gradient(
      to right,
      transparent,
      var(--accent-2) 35%,
      var(--accent) 65%,
      transparent
    );
    opacity: 0.6;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
    padding-top: 12px;
  }

  .service-card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    background: linear-gradient(
      145deg,
      var(--bg-elevated) 10%,
      color-mix(in srgb, var(--accent) 42%, var(--bg-elevated))
    );
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: opacity 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  /* al pasar el mouse por la grilla, la tarjeta apuntada se resalta y las
     demás se atenúan un poco */
  .services__grid:hover .service-card:not(:hover) {
    opacity: 0.55;
  }

  .service-card:hover {
    border-color: var(--accent-2);
    transform: translateY(-4px);
  }

  /* el plan destacado usa el mismo degradé de fondo que las demás, pero se
     distingue por un trazo (borde) con degradé verde y blanco muy sutil —
     truco de doble background: el degradé de fondo va "dentro" del borde
     (padding-box) y el degradé del trazo va "en" el borde (border-box). Se
     agranda un 13% y sube de z-index para resaltar sobre las demás. */
  .service-card--highlight {
    border: 1.5px solid transparent;
    padding: 34px 32px;
    background:
      linear-gradient(
        145deg,
        var(--bg-elevated) 10%,
        color-mix(in srgb, var(--accent) 42%, var(--bg-elevated))
      ) padding-box,
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent-2) 55%, var(--border)),
        color-mix(in srgb, #ffffff 45%, var(--border))
      ) border-box;
    transform: scale(1.13);
    transform-origin: center;
    z-index: 2;
  }

  .service-card--highlight .service-card__title {
    font-size: 19px;
  }

  .service-card--highlight .service-card__icon {
    width: 44px;
    height: 44px;
  }

  .service-card--highlight:hover {
    /* sin esto, la regla genérica ".service-card:hover" pintaría el borde
       de un verde sólido y taparía el degradé del trazo */
    border-color: transparent;
    transform: scale(1.13) translateY(-4px);
  }

  /* la etiqueta va dentro del padding de la tarjeta (no montada sobre el
     borde), así nunca queda cortada. */
  .service-card__badge {
    position: relative;
    display: inline-block;
    align-self: flex-start;
    background: var(--accent-2);
    color: var(--bg);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border-radius: 999px;
    z-index: 1;
    margin-bottom: 12px;
  }

  .service-card__head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 1;
  }

  .service-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--accent-2);
    color: var(--accent-2);
  }

  .service-card__title {
    font-size: 17px;
    line-height: 1.25;
    color: var(--text);
  }

  .service-card__description {
    position: relative;
    z-index: 1;
    font-size: 13px;
    color: var(--text-muted);
    margin: 10px 0 0;
  }

  .service-card__price {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    margin: 20px 0 0;
  }

  .service-card__price span {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .service-card__price--consult {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-muted);
    font-style: italic;
    font-family: var(--font-serif-italic);
  }

  .service-card__line {
    height: 1px;
    background: var(--border);
    margin: 20px 0;
  }

  .service-card__items {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .service-card__items li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text);
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 5px;
    border: 1px solid var(--accent-2);
    color: var(--accent-2);
  }

  .service-card__cta {
    position: relative;
    z-index: 1;
    justify-content: center;
    align-self: stretch;
    text-align: center;
    gap: 6px;
    background: var(--services-accent);
    border-color: var(--services-accent);
    color: #fff;
    font-weight: 600;
  }

  .service-card__cta:hover {
    background: var(--services-accent);
    border-color: var(--services-accent);
    color: #fff;
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    /* en una sola columna el escalado se sale del ancho de pantalla, así
       que en mobile la tarjeta destacada se distingue solo por el trazo
       en degradé y la etiqueta, sin agrandarse. */
    .service-card--highlight {
      transform: none;
      margin: 8px 0;
    }

    .service-card--highlight:hover {
      transform: translateY(-4px);
    }
  }
</style>
