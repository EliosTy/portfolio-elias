---
import { projects } from "../data/projects.js";
import ProjectCard from "./ProjectCard.astro";

const featured = projects.filter((p) => p.featured).slice(0, 4);
const items = featured.length >= 4 ? featured : projects.slice(0, 4);
---

<section class="featured section" id="trabajo">
  <div class="container">
    <p class="eyebrow">Trabajo</p>
    <h2 class="featured__title">Proyectos destacados</h2>

    <div class="featured__grid">
      {items.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <div class="featured__cta">
      <a href="/trabajos" class="btn">Ver todos los trabajos</a>
    </div>
  </div>
</section>

<style>
  .featured__title {
    font-size: 32px;
    margin-bottom: 32px;
  }

  .featured__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .featured__cta {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  @media (max-width: 720px) {
    .featured__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
