---
const included = [
  {
    label: "Identidad de marca y logo",
    icon: "pen",
  },
  {
    label: "Lenguaje visual",
    icon: "palette",
  },
  {
    label: "Tono de voz",
    icon: "chat",
  },
  {
    label: "Guía de marca",
    icon: "notebook",
  },
  {
    label: "Exploración de conceptos",
    icon: "search",
  },
];
---

<section class="branding-highlight">
  <div class="container">
    <h2 class="branding-highlight__title">Branding Creativo</h2>
    <p class="branding-highlight__tagline">Una marca que se sienta inolvidable.</p>
    <p class="branding-highlight__description">
      <!-- TODO: ajustá este texto si querés otro enfoque. -->
      Le doy forma a una identidad audaz y memorable que comunique quién
      sos y qué representás — con claridad, confianza y consistencia.
    </p>

    <div class="branding-highlight__included">
      <p class="branding-highlight__included-title">
        Qué <span class="branding-highlight__included-title-accent">incluye</span>
      </p>
      <div class="branding-highlight__items">
        {included.map((item) => (
          <div class="included-item">
            <div class="included-item__icon">
              {item.icon === "pen" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 19l7-7 3 3-7 7-3-3z" />
                  <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
                  <path d="M2 2l7.586 7.586" />
                  <circle cx="11" cy="11" r="2" />
                </svg>
              )}
              {item.icon === "palette" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2a10 10 0 1 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.4-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.3c2 0 3.7-1.6 3.7-3.6C21 6.6 17 2 12 2z" />
                  <circle cx="7.5" cy="10.5" r="1.2" fill="currentColor" stroke="none" />
                  <circle cx="11" cy="7" r="1.2" fill="currentColor" stroke="none" />
                  <circle cx="15.5" cy="8" r="1.2" fill="currentColor" stroke="none" />
                </svg>
              )}
              {item.icon === "chat" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h13a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
                </svg>
              )}
              {item.icon === "notebook" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="3" width="16" height="18" rx="2" />
                  <line x1="8" y1="8" x2="16" y2="8" />
                  <line x1="8" y1="12" x2="16" y2="12" />
                  <line x1="8" y1="16" x2="12" y2="16" />
                </svg>
              )}
              {item.icon === "search" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="10.5" cy="10.5" r="6.5" />
                  <path d="M20 20l-4.35-4.35" />
                  <path d="M7.5 11.5l1.5-2 1.5 1 2-2.5" />
                </svg>
              )}
            </div>
            <span class="included-item__label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .branding-highlight {
    /* dorado — identidad/branding. Se define acá adentro (no en el tema
       global) para que solo afecte a esta sección; MotionIntro.astro hace
       lo mismo pero con cian.
       Ahora el color ocupa todo el ancho de la sección (sin tarjeta, sin
       trazo, sin bordes redondeados) y va pegada a Motion Creativo, sin
       espacio entre las dos. El texto muted usa un gris cálido propio en
       vez del --text-muted del tema (ese tiene un tinte violeta). */
    --branding-accent: #d4af37;
    --branding-accent-soft: #f0d685;
    --branding-bg: #241b09;
    --branding-muted: #cdbfa0;
    padding: 64px 0;
    background: linear-gradient(
      to left,
      color-mix(in srgb, var(--branding-accent) 14%, var(--branding-bg)),
      var(--branding-bg)
    );
    border-top: 1px solid var(--border);
  }

  .branding-highlight__title {
    font-size: clamp(26px, 3.5vw, 36px);
    color: var(--branding-accent-soft);
  }

  .branding-highlight__tagline {
    font-family: var(--font-serif-italic);
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 26px);
    color: var(--text);
    margin: 6px 0 0;
  }

  .branding-highlight__description {
    margin: 16px 0 0;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--branding-muted);
  }

  .branding-highlight__included {
    margin-top: 40px;
    border: 1px solid color-mix(in srgb, var(--branding-accent) 30%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, black 30%, transparent);
    padding: 28px 32px;
  }

  .branding-highlight__included-title {
    font-size: 18px;
    color: var(--text);
    margin: 0 0 24px;
  }

  .branding-highlight__included-title-accent {
    font-family: var(--font-serif-italic);
    font-style: italic;
    color: var(--branding-accent-soft);
  }

  .branding-highlight__items {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
  }

  .included-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 110px;
    text-align: center;
    padding: 0 12px;
    border-left: 1px solid color-mix(in srgb, var(--branding-accent) 25%, transparent);
  }

  .included-item:first-child {
    border-left: none;
  }

  .included-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--branding-accent);
    color: #170f2c;
  }

  .included-item__label {
    font-size: 13px;
    color: var(--branding-muted);
  }

  @media (max-width: 860px) {
    .branding-highlight {
      padding: 40px 0;
    }

    .branding-highlight__items {
      justify-content: flex-start;
    }

    .included-item {
      border-left: none;
      min-width: 45%;
    }
  }
</style>
