---
const included = [
  {
    label: "Identidad de marca y logo",
    icon: "pen",
  },
  {
    label: "Lenguaje visual",
    icon: "palette",
  },
  {
    label: "Tono de voz",
    icon: "chat",
  },
  {
    label: "Guía de marca",
    icon: "notebook",
  },
  {
    label: "Exploración de conceptos",
    icon: "search",
  },
];
---

<section class="branding-highlight">
  <div class="branding-highlight__row">
    <div class="branding-highlight__media">
      <!-- Reemplazá este archivo en /public/branding/branding-video.mp4
           (video real cuadrado, 1000x1000px recomendado, mp4). -->
      <video
        class="branding-highlight__photo"
        src="/branding/branding-video.mp4"
        autoplay
        muted
        loop
        playsinline
      ></video>
    </div>

    <div class="branding-highlight__content">
    <h2 class="branding-highlight__title">Branding Creativo</h2>
    <p class="branding-highlight__tagline">Una marca que se sienta inolvidable.</p>
    <p class="branding-highlight__description">
      <!-- TODO: ajustá este texto si querés otro enfoque. -->
      Le doy forma a una identidad audaz y memorable que comunique quién
      sos y qué representás — con claridad, confianza y consistencia.
    </p>

    <div class="branding-highlight__included">
      <p class="branding-highlight__included-title">
        Qué <span class="branding-highlight__included-title-accent">incluye</span>
      </p>
      <div class="branding-highlight__items">
        {included.map((item) => (
          <div class="included-item">
            <div class="included-item__icon">
              {item.icon === "pen" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 19l7-7 3 3-7 7-3-3z" />
                  <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
                  <path d="M2 2l7.586 7.586" />
                  <circle cx="11" cy="11" r="2" />
                </svg>
              )}
              {item.icon === "palette" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2a10 10 0 1 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.4-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.3c2 0 3.7-1.6 3.7-3.6C21 6.6 17 2 12 2z" />
                  <circle cx="7.5" cy="10.5" r="1.2" fill="currentColor" stroke="none" />
                  <circle cx="11" cy="7" r="1.2" fill="currentColor" stroke="none" />
                  <circle cx="15.5" cy="8" r="1.2" fill="currentColor" stroke="none" />
                </svg>
              )}
              {item.icon === "chat" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h13a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
                </svg>
              )}
              {item.icon === "notebook" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="3" width="16" height="18" rx="2" />
                  <line x1="8" y1="8" x2="16" y2="8" />
                  <line x1="8" y1="12" x2="16" y2="12" />
                  <line x1="8" y1="16" x2="12" y2="16" />
                </svg>
              )}
              {item.icon === "search" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="10.5" cy="10.5" r="6.5" />
                  <path d="M20 20l-4.35-4.35" />
                  <path d="M7.5 11.5l1.5-2 1.5 1 2-2.5" />
                </svg>
              )}
            </div>
            <span class="included-item__label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  .branding-highlight {
    /* dorado — identidad/branding. Colores tomados de la referencia que
       pasaste (panel dorado con foto insertada). Se definen acá adentro
       (no en el tema global) para que solo afecten a esta sección;
       MotionIntro.astro hace lo mismo pero con azul índigo.
       El fondo dorado es claro/brillante, así que el texto usa tonos
       oscuros propios (--branding-ink / --branding-muted) en vez de los
       --text / --text-muted del tema, que están pensados para fondos
       oscuros y no tendrían contraste acá. */
    --branding-bg: #f3c000;
    --branding-ink: #1a1200;
    --branding-muted: #5c4a12;
    border-top: 1px solid var(--border);
  }

  .branding-highlight__row {
    display: flex;
    align-items: stretch;
    min-height: 480px;
    background: var(--branding-bg);
  }

  .branding-highlight__media {
    /* estirado a todo el alto de la fila (sin margen arriba ni abajo).
       El ancho queda lo más cerca posible de ese alto real (~560px en
       desktop normal) para que el recorte del video cuadrado sea mínimo
       — comprimimos la caja "Qué incluye" a una sola fila de íconos
       (ver .branding-highlight__items más abajo) para que la fila no
       quede demasiado alta y el recorte sea casi imperceptible. */
    flex: 0 0 auto;
    width: min(560px, 50vw);
    align-self: stretch;
  }

  .branding-highlight__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .branding-highlight__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 640px;
    padding: 56px clamp(24px, 6vw, 72px);
  }

  .branding-highlight__title {
    font-size: clamp(26px, 3.5vw, 36px);
    color: var(--branding-ink);
  }

  .branding-highlight__tagline {
    font-family: var(--font-serif-italic);
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 26px);
    color: var(--branding-ink);
    margin: 6px 0 0;
  }

  .branding-highlight__description {
    margin: 16px 0 0;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--branding-muted);
  }

  .branding-highlight__included {
    margin-top: 40px;
    border: 1px solid color-mix(in srgb, black 45%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, black 78%, transparent);
    padding: 28px 32px;
  }

  .branding-highlight__included-title {
    font-size: 18px;
    color: #fff;
    margin: 0 0 24px;
  }

  .branding-highlight__included-title-accent {
    font-family: var(--font-serif-italic);
    font-style: italic;
    color: var(--branding-bg);
  }

  .branding-highlight__items {
    /* una sola fila en desktop (nowrap) — mantiene la caja más baja para
       que la columna de video (ver .branding-highlight__media) no tenga
       que estirarse tanto y el recorte del video cuadrado sea mínimo.
       En mobile vuelve a envolver en 2 columnas (ver media query). */
    display: flex;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 14px;
  }

  .included-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
    text-align: center;
    padding: 0 8px;
    border-left: 1px solid color-mix(in srgb, #fff 15%, transparent);
  }

  .included-item:first-child {
    border-left: none;
  }

  .included-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--branding-bg);
    color: var(--branding-ink);
  }

  .included-item__label {
    font-size: 13px;
    color: #cfc7b3;
  }

  @media (max-width: 860px) {
    .branding-highlight__row {
      flex-direction: column;
      min-height: 0;
    }

    .branding-highlight__media {
      flex: none;
      width: 100%;
      aspect-ratio: 1 / 1;
    }

    .branding-highlight__content {
      max-width: none;
      padding: 40px 24px;
    }

    .branding-highlight__items {
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .included-item {
      border-left: none;
      min-width: 45%;
    }
  }
</style>

<script>
  // El video es cuadrado (1000x1000) y tiene que quedar pegado arriba y
  // abajo de la sección, SIN recortarse ni un pixel. El ancho vía CSS
  // (clamp/vw) es solo una aproximación — acá lo ajustamos con JS para
  // que el ancho quede exactamente igual al alto real ya renderizado,
  // pixel a pixel, sin importar el largo del texto ni el ancho de
  // pantalla. Por debajo de 860px no hace falta (ahí ya es un cuadrado
  // simple de ancho completo por CSS).
  function syncSquare(selector: string) {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el) return;

    const mq = window.matchMedia("(min-width: 861px)");

    function sync() {
      if (!el) return;
      if (!mq.matches) {
        el.style.width = "";
        return;
      }
      const height = el.getBoundingClientRect().height;
      if (height > 0) {
        el.style.width = `${height}px`;
      }
    }

    if ("ResizeObserver" in window) {
      const ro = new ResizeObserver(() => sync());
      ro.observe(el);
    } else {
      window.addEventListener("resize", sync);
    }
    mq.addEventListener("change", sync);
    sync();
  }

  syncSquare(".branding-highlight__media");
</script>
