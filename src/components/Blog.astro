---
// sección de blog para la portada — mini posts, proyectos personales, etc.
// (no es la página completa de blog, es la vista previa de portada, según
// las capturas de referencia). Los datos salen de src/data/blog.js, mismo
// patrón editable que projects.js / clients.js / services.js.
import { posts } from "../data/blog.js";

const items = posts.slice(0, 3);
---

<section class="section blog" id="blog">
  <div class="container">
    <div class="blog__header">
      <div>
        <p class="eyebrow">Blog</p>
        <h2 class="blog__title">
          <span class="blog__title-line">Todo se comparte</span>
        </h2>
        <p class="blog__subtitle">
          Acá comparto información sobre, diseño, inteligencia artificial,
          las herramientas que uso en mi día a día y mucho más.
        </p>
      </div>

      <a href="/blog" class="blog__cta">Ver todo el blog →</a>
    </div>

    <div class="blog__grid">
      {items.map((post) => (
        <a href={post.link || "#"} class="post-card">
          <div class="post-card__image">
            <img src={post.image} alt={post.title} loading="lazy" />
          </div>
          <div class="post-card__body">
            <p class="post-card__date">{post.date}</p>
            <h3 class="post-card__title">{post.title}</h3>
            <p class="post-card__excerpt">{post.excerpt}</p>
            <span class="post-card__link">Leer →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .blog__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }

  .blog__title {
    font-size: clamp(26px, 3.5vw, 38px);
    line-height: 1.15;
    display: flex;
    flex-direction: column;
  }

  .blog__title-line--accent {
    color: var(--accent-2);
  }

  .blog__subtitle {
    margin-top: 16px;
    max-width: 56ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .blog__cta {
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .blog__cta:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-elevated);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--accent-2);
    transform: translateY(-4px);
  }

  .post-card__image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .post-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .post-card:hover .post-card__image img {
    transform: scale(1.05);
  }

  .post-card__body {
    padding: 22px 22px 26px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .post-card__date {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .post-card__title {
    font-size: 18px;
    line-height: 1.3;
    color: var(--text);
  }

  .post-card__excerpt {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 2px 0 6px;
  }

  .post-card__link {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-2);
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .blog__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .blog__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
