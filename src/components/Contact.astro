---
// TODO: reemplazá por tu email real. El formulario abre el mail del
// visitante con estos datos ya cargados (no hay backend: es 100% estático).
const CONTACT_EMAIL = "tu@email.com";
---

<section class="contact section" id="contacto">
  <div class="container contact__inner">
    <p class="eyebrow">Contacto</p>
    <h2 class="contact__title">¿Tenés un proyecto en mente?<br />Hablemos.</h2>

    <form class="contact__form" id="contact-form" data-email={CONTACT_EMAIL}>
      <div class="field">
        <label for="mail">Tu mail</label>
        <input type="email" id="mail" name="mail" required placeholder="vos@ejemplo.com" />
      </div>
      <div class="field">
        <label for="asunto">Asunto</label>
        <input type="text" id="asunto" name="asunto" required placeholder="Sobre qué querés hablar" />
      </div>
      <div class="field">
        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="4" placeholder="Contame un poco sobre tu proyecto"></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Enviar</button>
      <p class="contact__hint">Se abre tu app de mail con todo esto ya cargado.</p>
    </form>

    <div class="contact__links">
      <a href={`mailto:${CONTACT_EMAIL}`} class="btn">{CONTACT_EMAIL}</a>
      <a href="https://instagram.com/tu_usuario" class="btn" target="_blank" rel="noopener">Instagram</a>
      <a href="https://linkedin.com/in/tu_usuario" class="btn" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</section>

<style>
  .contact {
    border-bottom: none;
  }

  .contact__inner {
    text-align: center;
    padding: 40px 0 20px;
  }

  .contact__title {
    font-size: clamp(28px, 4vw, 42px);
    margin: 20px 0 40px;
  }

  .contact__form {
    max-width: 480px;
    margin: 0 auto 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-size: 13px;
    color: var(--text-muted);
  }

  .field input,
  .field textarea {
    font-family: var(--font-body);
    font-size: 14px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent-2);
  }

  .contact__form .btn {
    align-self: center;
    min-width: 160px;
    border: none;
    cursor: pointer;
  }

  .contact__hint {
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }

  .contact__links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const email = form.dataset.email || "";
    const mail = (form.querySelector("#mail") as HTMLInputElement)?.value || "";
    const asunto = (form.querySelector("#asunto") as HTMLInputElement)?.value || "";
    const mensaje = (form.querySelector("#mensaje") as HTMLTextAreaElement)?.value || "";

    const subject = encodeURIComponent(asunto);
    const body = encodeURIComponent(`${mensaje}\n\n— Mi mail: ${mail}`);

    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
