---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TySpace — Elias, Diseño Gráfico & Motion Graphics",
  description = "TySpace: el espacio de Elias para diseño gráfico, motion graphics y proyectos personales.",
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="tyspace">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- favicon.svg cubre las pestañas de escritorio (Chrome/Firefox/Edge
         soportan SVG ahí), pero los accesos directos de celular (iOS
         "agregar a inicio" / recientes de Chrome, Android) no lo leen y
         necesitan sí o sí un PNG — por eso los de abajo. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b0616" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Fraunces:ital,wght@1,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Hyperspace Race (Adobe Fonts / Typekit) — la tipografía del logo,
         usada como fuente de títulos en todo el sitio. -->
    <link rel="stylesheet" href="https://use.typekit.net/yer2ijt.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
