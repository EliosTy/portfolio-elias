---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Elias — Diseño Gráfico & Motion Graphics",
  description = "Portfolio de diseño gráfico, motion graphics y proyectos personales.",
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="oscuro-minimal">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
